{
  "active": true,
  "name": "HR 급여 조회",
  "schema": "skill-1.0.0",
  "version": "1.0.0",
  "hubId": "hr-salary",
  "author": "teamplgpt",
  "description": "직원 급여 정보를 조회합니다. query_type으로 조회 종류를 선택합니다: account(이체계좌), annual_total(연간총액), base_amount(기본급연봉), bonus(성과급상여), compare(월별비교), deductions(공제항목), leave_pay_rate(휴직급여율), pay_step(호봉), payslip(급여명세서), retroactive(소급급여). 결과는 Markdown 표 형식으로 반환됩니다.",
  "entrypoint": {
    "file": "handler.js",
    "params": {
      "emp_no": {
        "description": "사원번호 (필수). 예: '12345'",
        "type": "string"
      },
      "query_type": {
        "description": "조회 종류 (필수).",
        "type": "string",
        "enum": ["account", "annual_total", "base_amount", "bonus", "compare", "deductions", "leave_pay_rate", "pay_step", "payslip", "retroactive"]
      },
      "year_month": {
        "description": "조회 연월 (선택, YYYYMM). payslip, deductions, retroactive 조회 시 사용. 예: '202603'",
        "type": "string"
      },
      "year": {
        "description": "조회 연도 (선택, YYYY). annual_total, bonus 조회 시 사용. 예: '2026'",
        "type": "string"
      },
      "current_month": {
        "description": "비교 기준월 (선택, YYYYMM). compare 조회 시 사용.",
        "type": "string"
      },
      "previous_month": {
        "description": "비교 이전월 (선택, YYYYMM). compare 조회 시 사용.",
        "type": "string"
      },
      "limit": {
        "description": "최대 조회 건수 (선택, 정수). retroactive 조회 시 사용.",
        "type": "string"
      }
    },
    "required": ["emp_no", "query_type"]
  },
  "setup_args": {
    "HR_API_BASE_URL": {
      "type": "string",
      "required": true,
      "input": {
        "type": "text",
        "default": "http://host.docker.internal:8000",
        "placeholder": "http://host.docker.internal:8000",
        "hint": "HR REST API 서버 주소."
      },
      "value": "http://localhost:8000"
    }
  },
  "examples": [
    {
      "prompt": "이번 달 급여명세서 조회해줘",
      "call": "{\"emp_no\": \"12345\", \"query_type\": \"payslip\", \"year_month\": \"202603\"}"
    },
    {
      "prompt": "올해 연간 급여 총액 알려줘",
      "call": "{\"emp_no\": \"12345\", \"query_type\": \"annual_total\", \"year\": \"2026\"}"
    },
    {
      "prompt": "내 기본급 얼마야?",
      "call": "{\"emp_no\": \"12345\", \"query_type\": \"base_amount\"}"
    },
    {
      "prompt": "이번달 공제 항목 알려줘",
      "call": "{\"emp_no\": \"12345\", \"query_type\": \"deductions\", \"year_month\": \"202603\"}"
    },
    {
      "prompt": "2월 3월 급여 비교해줘",
      "call": "{\"emp_no\": \"12345\", \"query_type\": \"compare\", \"current_month\": \"202603\", \"previous_month\": \"202602\"}"
    }
  ],
  "imported": true,
  "license": "MIT"
}