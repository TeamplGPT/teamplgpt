{
  "active": true,
  "name": "HR 근태 조회",
  "schema": "skill-1.0.0",
  "version": "1.0.0",
  "hubId": "hr-attendance",
  "author": "teamplgpt",
  "description": "직원 근태 정보를 조회합니다. query_type으로 조회 종류를 선택합니다: annual_leave_balance(연차잔여), annual_leave_plan(연차계획), business_trips(출장내역), leave_requests(휴가신청), overtime(연장근무), substitute_leave(대체휴무), timesheet(출퇴근기록), timesheet_requests(출퇴근변경신청), work_plan_weekly(주간근무계획), work_type(오늘근무유형). 결과는 Markdown 표 형식으로 반환됩니다.",
  "entrypoint": {
    "file": "handler.js",
    "params": {
      "emp_no": {
        "description": "사원번호 (필수). 예: '12345'",
        "type": "string"
      },
      "query_type": {
        "description": "조회 종류 (필수).",
        "type": "string",
        "enum": ["annual_leave_balance", "annual_leave_plan", "business_trips", "leave_requests", "overtime", "substitute_leave", "timesheet", "timesheet_requests", "work_plan_weekly", "work_type"]
      },
      "year_month": {
        "description": "조회 연월 (선택, YYYYMM). timesheet, overtime 조회 시 사용. 예: '202603'",
        "type": "string"
      },
      "year": {
        "description": "조회 연도 (선택, YYYY). annual_leave_balance 조회 시 사용. 예: '2026'",
        "type": "string"
      },
      "base_date": {
        "description": "기준일 (선택, YYYYMMDD). work_plan_weekly 조회 시 사용. 예: '20260311'",
        "type": "string"
      },
      "status": {
        "description": "승인 상태 (선택). leave_requests 조회 시 사용. 예: '30'(결재완료)",
        "type": "string"
      },
      "months": {
        "description": "조회 개월수 (선택, 정수). leave_requests 조회 시 사용. 예: 3",
        "type": "string"
      },
      "limit": {
        "description": "최대 조회 건수 (선택, 정수). business_trips, substitute_leave, timesheet_requests 조회 시 사용.",
        "type": "string"
      }
    },
    "required": ["emp_no", "query_type"]
  },
  "setup_args": {
    "HR_API_BASE_URL": {
      "type": "string",
      "required": true,
      "input": {
        "type": "text",
        "default": "http://host.docker.internal:8000",
        "placeholder": "http://host.docker.internal:8000",
        "hint": "HR REST API 서버 주소."
      },
      "value": "http://localhost:8000"
    }
  },
  "examples": [
    {
      "prompt": "이번 달 연차 잔여일 알려줘",
      "call": "{\"emp_no\": \"12345\", \"query_type\": \"annual_leave_balance\"}"
    },
    {
      "prompt": "3월 출퇴근 기록 조회해줘",
      "call": "{\"emp_no\": \"12345\", \"query_type\": \"timesheet\", \"year_month\": \"202603\"}"
    },
    {
      "prompt": "이번 달 연장근무 내역 보여줘",
      "call": "{\"emp_no\": \"12345\", \"query_type\": \"overtime\", \"year_month\": \"202603\"}"
    },
    {
      "prompt": "오늘 근무 유형 뭐야",
      "call": "{\"emp_no\": \"12345\", \"query_type\": \"work_type\"}"
    },
    {
      "prompt": "최근 휴가 신청 목록 알려줘",
      "call": "{\"emp_no\": \"12345\", \"query_type\": \"leave_requests\", \"months\": \"3\"}"
    }
  ],
  "imported": true,
  "license": "MIT"
}