{
  "active": true,
  "name": "HR 인사기록 조회",
  "schema": "skill-1.0.0",
  "version": "1.0.0",
  "hubId": "hr-personnel",
  "author": "teamplgpt",
  "description": "직원 인사기록을 조회합니다. query_type으로 조회 종류를 선택합니다: address(주소), appointment_current(현재직위직급), career(전직경력), contact(연락처), disciplines(징계이력), education(학력), employment(입사일근속), family(가족정보), licenses(자격증), rewards(포상이력), visa(비자정보). 결과는 Markdown 표 형식으로 반환됩니다.",
  "entrypoint": {
    "file": "handler.js",
    "params": {
      "emp_no": {
        "description": "사원번호 (필수). 예: '12345'",
        "type": "string"
      },
      "query_type": {
        "description": "조회 종류 (필수).",
        "type": "string",
        "enum": ["address", "appointment_current", "career", "contact", "disciplines", "education", "employment", "family", "licenses", "rewards", "visa"]
      }
    },
    "required": ["emp_no", "query_type"]
  },
  "setup_args": {
    "HR_API_BASE_URL": {
      "type": "string",
      "required": true,
      "input": {
        "type": "text",
        "default": "http://host.docker.internal:8000",
        "placeholder": "http://host.docker.internal:8000",
        "hint": "HR REST API 서버 주소."
      },
      "value": "http://localhost:8000"
    }
  },
  "examples": [
    {
      "prompt": "내 현재 직위 알려줘",
      "call": "{\"emp_no\": \"12345\", \"query_type\": \"appointment_current\"}"
    },
    {
      "prompt": "입사일이 언제야?",
      "call": "{\"emp_no\": \"12345\", \"query_type\": \"employment\"}"
    },
    {
      "prompt": "학력 정보 조회해줘",
      "call": "{\"emp_no\": \"12345\", \"query_type\": \"education\"}"
    },
    {
      "prompt": "보유 자격증 알려줘",
      "call": "{\"emp_no\": \"12345\", \"query_type\": \"licenses\"}"
    }
  ],
  "imported": true,
  "license": "MIT"
}